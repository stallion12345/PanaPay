{
  "name": "panapay",
  "version": "1.0.0",
  "description": "PanaPay: know who owes you, what they promised, and whether PayPal confirms they paid",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "test": "node --test --test-concurrency=1 ./src/**/*.test.js",
    "seed": "node --env-file=.env scripts/seed-base.mjs",
    "seed:history": "node --env-file=.env scripts/seed-history.mjs"
  },
  "keywords": [
    "paypal",
    "sandbox",
    "fintech",
    "express"
  ],
  "author": "chukwuemeka chukwuma",
  "license": "MIT",
  "engines": { "node": ">=24" },
  "dependencies": {
    "express": "^5.3.0",
    "zod": "^3.23.8"
  }
}
