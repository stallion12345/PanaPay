PORT=3000

# PayPal sandbox app: developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
# Email of your sandbox BUSINESS account (the merchant that issues invoices)
PAYPAL_MERCHANT_EMAIL=your_sandbox_business_email
# Only needed for the live "Paid" update (webhook ID from your sandbox app)
PAYPAL_WEBHOOK_ID=your_webhook_id

# Email of a sandbox PERSONAL account that will pay invoices (becomes "Sandbox Customer")
CUSTOMER_EMAIL=your_sandbox_personal_email

# AI (Gemini has a free tier)
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_key
LLM_MODEL=gemini-3.5-flash-lite